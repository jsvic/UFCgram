<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import atlantafx.base.controls.Card?>
<StackPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ufcgram.controller.ControllerCadastroFinais">
    <BorderPane>
        <top>
            <fx:include source="parcials/header.fxml"/>
        </top>

        <center>
           <Card styleClass="form">
               <header>
                   <VBox>
                       <Label styleClass="title-3" text="Criando sua Conta"/>
                        <Separator/>
                   </VBox>
               </header>
               <subHeader>
                   <Label styleClass="text-lighter" text="Finalizando seu cadastro"/>
               </subHeader>

               <body>
                   <GridPane styleClass="gridForm">
                       <columnConstraints>
                           <ColumnConstraints percentWidth="50"/>
                           <ColumnConstraints percentWidth="50"/>
                       </columnConstraints>

                       <VBox
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="0"
                               GridPane.columnSpan="2"
                       >
                           <Label styleClass="text-normal" text="Descrição" />

                           <TextArea
                                   fx:id="inDescricao"
                                   promptText="Digite sua descrição"
                                   prefRowCount="5"
                                   wrapText="true"
                                   styleClass="large"/>
                       </VBox>

                       <VBox
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="0"
                       >
                           <Label styleClass="text-normal" text="Senha" />
                           <PasswordField
                                   fx:id="inSenha"
                                   styleClass="large, tranparent"
                                   promptText="Senha"
                                   prefWidth="150"

                           />

                           <Label
                                   fx:id="senhaErrorLabel"
                                   styleClass="danger"
                                   wrapText="true"/>
                       </VBox>

                       <VBox
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="1"
                       >
                           <Label styleClass="text-normal" text="Confirmar Senha" />
                           <PasswordField
                                   fx:id="inConfirmaSenha"
                                   styleClass="large, tranparent"
                                   promptText="Senha"
                                   prefWidth="150"

                           />
                       </VBox>
                       <HBox
                               styleClass="buttonGroup"
                               GridPane.columnIndex="0"
                               GridPane.rowIndex="2"
                       >

                           <Button
                                   text="Criar"
                                   styleClass="accent"
                                   onAction="#cadastrar"
                                   alignment="BOTTOM_LEFT"

                           />

                           <Button
                                   text="Limpar"
                                   styleClass="danger"
                                   alignment="BOTTOM_LEFT"
                           />

                       </HBox>
                   </GridPane>
               </body>
           </Card>
        </center>
    </BorderPane>
</StackPane>
