<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      styleClass="navBar"
      fx:controller="com.example.ufcgram.controller.ControllerNavBar"
>
    <VBox styleClass="vboxNavConta">
        <Button text="Ver Conta" onAction="#abrirContaSessao" fx:id="navButton" styleClass="accent"/>
        <Button text="Criar Publicação" fx:id="btnCriarPublicacao" onAction="#abrirCriarPublicacao" styleClass="accent"/>
    </VBox>
    <VBox styleClass="vboxContasRecomendadas">
        <Label text="Contas Recomendadas" styleClass="title-3"/>
        <HBox styleClass="contentSearch">
            <TextField promptText="Pesquisar Conta" styleClass="search"/>
            <Button text="buscar" styleClass="accent"/>
        </HBox>

        <ScrollPane fitToWidth="true"
                    fitToHeight="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED">
            <VBox fx:id= "usuarioList" styleClass="usuarioList">

            </VBox>
        </ScrollPane>
    </VBox>
</VBox>
