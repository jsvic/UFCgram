<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.example.ufcgram.controller.ControllerUsuario"
        stylesheets="@../../style/usuario.css"
        managed="false"
        visible="false"
        fx:id="usuario"
        styleClass="usuario"
>
    <ScrollPane fitToWidth="true"
                fitToHeight="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED">
            <VBox styleClass="mainConta">
                <VBox styleClass="informacoesPrincipais">
                    <HBox>
                        <Label fx:id="nomeConta" styleClass="title-1"/>
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox spacing="20">
                            <Label fx:id="seguidores" styleClass="text-bold"/>
                            <Label fx:id="seguindos" styleClass="text-bold"/>
                        </HBox>
                    </HBox>
                        <Label fx:id="cursoConta" styleClass="title-2"/>
                    <TextArea fx:id="descricaoConta" styleClass="descricaoConta" disable="true"/>
                    <HBox styleClass="btnGroup" fx:id="btnGroup">
                        <Button text="Seguir" fx:id="btnSeguir" onAction="#seguir" styleClass="accent"/>
                        <Button text="Seguindo" fx:id="btnDeixarSeguir" onAction="#deixarSeguir" styleClass="ordinary"/>
                    </HBox>
                </VBox>

                <Separator/>

                    <VBox styleClass="contentPost">
                        <HBox styleClass="contentSearch">
                            <TextField promptText="Pesquisar Post" styleClass="search"/>
                            <Button text="buscar" styleClass="accent"/>
                        </HBox>

                                    <VBox fx:id="postList" styleClass="postList">

                                </VBox>
                    </VBox>
            </VBox>
                    </ScrollPane>

    <VBox styleClass="informacoesPerfil">
            <VBox>
                <Label text="Email:"/>
                <Label fx:id="emailConta"/>
            </VBox>

            <VBox>
                <Label text="Idade:"/>
                <Label fx:id="idadeConta"/>
            </VBox>

            <VBox>
                <Label text="Gênero:"/>
                <Label fx:id="generoConta"/>
            </VBox>

            <VBox>
                <Label text="Matrícula:"/>
                <Label fx:id="matrConta"/>
            </VBox>

            <VBox>
                <Label text="Campus:"/>
                <Label fx:id="campusConta"/>
            </VBox>

            <VBox>
                <Label text="Semestre que entrou:"/>
                <Label fx:id="semetreConta"/>
            </VBox>
    </VBox>
</HBox>
