<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>

<?import atlantafx.base.controls.Card?>
<HBox
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.example.ufcgram.controller.ControllerUsuario"
        stylesheets="@../../style/usuario.css"
        managed="false"
        visible="false"
        fx:id="usuario"
        styleClass="usuario"
>
    <VBox styleClass="mainConta">
        <VBox styleClass="informacoesPrincipais">
            <HBox>
                <Label fx:id="nomeConta" styleClass="title-1"/>
                <Region HBox.hgrow="ALWAYS" />
                <HBox spacing="20">
                    <Label fx:id="seguidores" styleClass="text-bold"/>
                    <Label fx:id="seguindos" styleClass="text-bold"/>
                </HBox>
            </HBox>
                <Label fx:id="cursoConta" styleClass="title-2"/>
            <TextArea fx:id="descricaoConta" styleClass="descricaoConta" disable="true"/>
            <HBox styleClass="btnGroup" fx:id="btnGroup">
                <Button text="Seguir" fx:id="btnSeguir" onAction="#seguir" styleClass="accent"/>
                <Button text="Seguindo" fx:id="btnDeixarSeguir" onAction="#deixarSeguir" styleClass="ordinary"/>
            </HBox>
        </VBox>

        <Separator/>

            <VBox styleClass="contentPost">
                <HBox styleClass="contentSearch">
                    <TextField promptText="Pesquisar Post" styleClass="search"/>
                    <Button text="buscar" styleClass="accent"/>
                    <Button text="Posts Interagidos" styleClass="ordinary"/>
                </HBox>
                <ScrollPane fitToWidth="true"
                            fitToHeight="true"
                            hbarPolicy="NEVER"
                            vbarPolicy="AS_NEEDED"
                >
                            <VBox styleClass="postList">
                                <Card styleClass="postTexto">
                                    <header>
                                        <VBox>
                                            <HBox styleClass="postHeader">
                                                <Label text="Criado por: Pedrin" styleClass="title-3"/>
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label text="23-11-26" styleClass="text-lighter"/>
                                                <MenuButton text="⋮">
                                                    <items>
                                                        <MenuItem text="Editar" onAction="#abrirModalEditar"/>
                                                        <MenuItem text="Excluir" onAction="#abrirModalExcluir"/>
                                                    </items>
                                                </MenuButton>
                                            </HBox>
                                            <Separator/>
                                        </VBox>
                                    </header>
                                    <body>
                                        <VBox>
                                            <TextArea text="Lorem ipsum dolor sitreeverra tempor quis eget augue. Curabis di"
                                                      editable="false"
                                                      wrapText="true"
                                                      styleClass="postConteudo"/>
                                        </VBox>

                                    </body>
                                    <footer>
                                        <VBox>
                                            <Separator/>
                                            <HBox styleClass="buttonGroup">
                                                <Button text="Curtir" styleClass="accent"/>
                                                <Button text="Comentar" styleClass="ordinary" onAction="#abrirModalComentarios"/>
                                            </HBox>
                                        </VBox>
                                    </footer>
                                </Card>

                                <Card styleClass="postEvento">
                                    <header>
                                        <VBox>
                                            <HBox>
                                                <Label text="Título" styleClass="title-1"/>
                                                <Region HBox.hgrow="ALWAYS" />
                                                <MenuButton text="⋮">
                                                    <items>
                                                        <MenuItem text="Editar"/>
                                                        <MenuItem text="Excluir"/>
                                                    </items>
                                                </MenuButton>
                                            </HBox>
                                            <HBox>
                                                <Label text="Criado por: Gal" styleClass="text-bold"/>
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label text="23-11-26" styleClass="text-lighter"/>
                                            </HBox>
                                            <Separator/>
                                        </VBox>
                                    </header>

                                    <body>
                                        <VBox>
                                            <TextArea text="Lorem ipsum dolor sitreeverra tempor quis eget augue. Curabis di"
                                                      editable="false"
                                                      wrapText="true"
                                                      styleClass="postConteudo"/>

                                            <HBox styleClass="postEventoInfos">
                                                <Label text="Local: Sla"/>
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label text="Data do Evento: 12/11/26"/>
                                            </HBox>
                                        </VBox>

                                    </body>
                                    <footer>
                                        <VBox>
                                            <Separator/>
                                            <HBox styleClass="buttonGroup">
                                                <Button text="Curtir" styleClass="accent"/>
                                                <Button text="Comentar" styleClass="ordinary"/>
                                            </HBox>
                                        </VBox>
                                    </footer>
                                </Card>
                        </VBox>
                    </ScrollPane>
            </VBox>
    </VBox>

    <VBox styleClass="informacoesPerfil">
            <VBox>
                <Label text="Email:"/>
                <Label fx:id="emailConta"/>
            </VBox>

            <VBox>
                <Label text="Idade:"/>
                <Label fx:id="idadeConta"/>
            </VBox>

            <VBox>
                <Label text="Gênero:"/>
                <Label fx:id="generoConta"/>
            </VBox>

            <VBox>
                <Label text="Matrícula:"/>
                <Label fx:id="matrConta"/>
            </VBox>

            <VBox>
                <Label text="Campus:"/>
                <Label fx:id="campusConta"/>
            </VBox>

            <VBox>
                <Label text="Semestre que entrou:"/>
                <Label fx:id="semetreConta"/>
            </VBox>
    </VBox>
</HBox>
