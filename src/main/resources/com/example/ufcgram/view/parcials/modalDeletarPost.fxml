<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


<?import atlantafx.base.controls.ModalPane?>
<?import atlantafx.base.layout.ModalBox?>
<?import atlantafx.base.controls.Card?>
<ModalPane
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        stylesheets="@../../style/modal.css"
        fx:controller="com.example.ufcgram.controller.ControllerModalDeletarPost"
        fx:id="modalPane"
        alignment="CENTER"
>
    <fx:define>

        <ModalBox fx:id="modalBox" styleClass="modalBox">
            <children>
                <Card styleClass="modalCard"
                      AnchorPane.topAnchor="40"
                      AnchorPane.rightAnchor="0"
                      AnchorPane.bottomAnchor="0"
                      AnchorPane.leftAnchor="0"
                >
                    <header>
                        <VBox>
                            <Label text="Deletar a Publicação" styleClass="title-1"/>
                            <Separator/>
                        </VBox>
                    </header>
                    <body>
                        <VBox styleClass="cardBody">
                            <Button
                                    text="Deletar"
                                    styleClass="danger"
                                    onAction="#deletar"
                            />
                        </VBox>
                    </body>
                </Card>
            </children>

        </ModalBox>
    </fx:define>
</ModalPane>