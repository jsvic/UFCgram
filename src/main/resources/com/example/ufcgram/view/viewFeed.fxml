<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<StackPane fx:controller="com.example.ufcgram.controller.ControllerFeed" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
    <BorderPane>
        <top>
            <fx:include
                    fx:id="headerFeed"
                    source="parcials/headerFeed.fxml"/>
        </top>
        <left>
                <fx:include
                        fx:id="navBar"
                        source="parcials/navBar.fxml"/>
        </left>
        <center>
           <HBox styleClass="containerFeed">

               <fx:include
                        fx:id="mainFeed"
                        source="parcials/mainFeed.fxml"/>

               <fx:include source="parcials/usuario.fxml" fx:id="usuario"/>
               <fx:include source="parcials/createPublicacao.fxml" fx:id="createPost"/>

           </HBox>
        </center>
    </BorderPane>
    <VBox
            StackPane.alignment="BOTTOM_RIGHT"
            styleClass="message-container"
            pickOnBounds="false"
    >
        <StackPane.margin>
            <Insets right="20" top="20"/>
        </StackPane.margin>

        <fx:include fx:id="mensagem" source="parcials/message.fxml"/>
    </VBox>

    <fx:include source="parcials/modalDeletarPost.fxml" fx:id="modalExcluir"/>
    <fx:include source="parcials/modalEditarPost.fxml" fx:id="modalEditar"/>
    <fx:include source="parcials/modalComentarios.fxml" fx:id="modalComentarios"/>

</StackPane>
